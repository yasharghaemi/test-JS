{
  "groups": [
    { "id": "type", "title": "Page type", "summary": "values", "open": true, "wide": true },
    { "id": "display", "title": "Display & status", "summary": "values", "open": true },
    { "id": "license", "title": "License", "summary": "values" },
    { "id": "attribution", "title": "Attribution", "summary": "count", "wide": true },
    { "id": "publishing", "title": "Publishing", "summary": "values" },
    { "id": "print", "title": "Print", "summary": "values" }
  ],
  "fields": [
    {
      "label": "Article type",
      "prefix": "article:",
      "group": "type",
      "hiddenForEditors": true,
      "options": [
        ["article:topic-category", "Book or Unit"],
        ["article:topic-guide", "Chapter"],
        ["article:topic", "Section or Page"],
        ["article:howto", "N/A"],
        ["article:reference", "N/A"]
      ]
    },
    {
      "label": "Stage",
      "prefix": "stage:",
      "group": "display",
      "forAuthors": true,
      "options": [
        ["stage:stub", "Stub"],
        ["stage:draft", "Draft"],
        ["stage:review", "Review"],
        ["stage:final", "Final"],
        ["stage:outdated", "Outdated"],
        ["stage:obsolete", "Obsolete"]
      ]
    },
    {
      "label": "Show Page TOC",
      "prefix": "showtoc:",
      "group": "display",
      "forAuthors": true,
      "askApplyToSubpages": true,
      "options": [
        ["showtoc:yes", "yes on page"],
        ["showtoc:no", "no on page"]
      ]
    },
    {
      "label": "Autonumber Section Headings",
      "prefix": "autonumheader:",
      "group": "display",
      "forAuthors": true,
      "askApplyToSubpages": true,
      "options": [
        ["autonumheader:yes1", "title with space delimiters"],
        ["autonumheader:yes2", "title with colon delimiters"],
        ["autonumheader:yes3", "title with dash delimiters"]
      ]
    },
    {
      "label": "Override Autonumber",
      "prefix": "override:",
      "group": "display",
      "options": [
        ["override:yes", "yes"],
        ["override:no", "no"]
      ]
    },
    {
      "label": "Cover Page",
      "prefix": "coverpage:",
      "group": "publishing",
      "hiddenForEditors": true,
      "options": [
        ["coverpage:yes", "Set Cover Page/Add to Download Center"],
        ["coverpage:toc", "Set Cover Page/Not in Download Center"]
      ]
    },
    {
      "label": "Transcluded",
      "prefix": "transcluded:",
      "group": "publishing",
      "detect": "transclusion",
      "options": [
        ["transcluded:yes", "yes"]
      ]
    },
    {
      "label": "Student Analytics",
      "prefix": "studentanalytics:",
      "group": "publishing",
      "askApplyToSubpages": true,
      "options": [
        ["studentanalytics:yes", "yes"]
      ]
    },
    {
      "label": "Number of Print Columns",
      "prefix": "columns:",
      "group": "print",
      "askApplyToSubpages": true,
      "options": [
        ["columns:two", "Two"],
        ["columns:three", "Three"]
      ]
    },
    {
      "label": "Print CSS",
      "prefix": "cssprint:",
      "group": "print",
      "askApplyToSubpages": true,
      "options": [
        ["cssprint:default", "Default"],
        ["cssprint:dense", "Dense"]
      ]
    },
    {
      "label": "Author",
      "prefix": "author@",
      "type": "author",
      "group": "attribution",
      "askApplyToSubpages": true,
      "options": []
    },
    {
      "label": "Editor",
      "prefix": "editor@",
      "type": "author",
      "group": "attribution",
      "askApplyToSubpages": true,
      "options": []
    },
    {
      "label": "Remixer",
      "prefix": "remixer@",
      "type": "author",
      "group": "attribution",
      "askApplyToSubpages": true,
      "options": []
    },
    {
      "label": "Translator",
      "prefix": "translator@",
      "type": "author",
      "group": "attribution",
      "askApplyToSubpages": true,
      "options": []
    },
    {
      "label": "Contributor",
      "prefix": "contributor@",
      "type": "author",
      "group": "attribution",
      "askApplyToSubpages": true,
      "options": []
    },
    {
      "label": "Illustrator",
      "prefix": "illustrator@",
      "type": "author",
      "group": "attribution",
      "askApplyToSubpages": true,
      "options": []
    },
    {
      "label": "Reviewer",
      "prefix": "reviewedBy@",
      "type": "author",
      "group": "attribution",
      "askApplyToSubpages": true,
      "options": []
    },
    {
      "label": "License",
      "prefix": "license:",
      "versionPrefix": "licenseversion:",
      "type": "license",
      "group": "license",
      "askApplyToSubpages": true,
      "forAuthors": true,
      "options": []
    }
  ],
  "roleViews": {
    "admin": "full",
    "editor": "editor",
    "author": "author"
  },
  "defaultView": "full",
