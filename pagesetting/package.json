{
  "name": "pagesetting",
  "version": "1.0.0",
  "private": true,
  "description": "Custom Page settings panel for the MindTouch editor",
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "esbuild src/index.ts --bundle --format=iife --target=es2019 --minify --sourcemap --legal-comments=none --outfile=dist/pagesetting.min.js",
    "build:css": "esbuild pagesetting.css --minify --outfile=dist/pagesetting.min.css",
    "watch": "esbuild src/index.ts --bundle --format=iife --target=es2019 --sourcemap --outfile=dist/pagesetting.min.js --watch",
    "typecheck": "tsc --noEmit",
    "dev": "esbuild src/index.ts pagesetting.css --bundle --format=iife --target=es2019 --sourcemap --entry-names=pagesetting --outdir=.dev --servedir=.dev --serve=localhost:8000 --watch=forever",
    "dev:sandbox": "esbuild src/index.ts pagesetting.css --bundle --format=iife --target=es2019 --sourcemap --entry-names=pagesetting --outdir=.dev --servedir=.dev --serve=0.0.0.0:8000 --watch=forever"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
